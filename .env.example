# Copy to .env and fill in. Never commit .env.

# Owner connection: ingest pipeline and schema migrations.
ANALYST_DB_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/analyst-agent

# Read-only connection used by the MCP server. Create this role with
# db/schema/003_roles.sql, supplying the password at apply time:
#   psql -d "analyst-agent" -v ro_password="<pw>" -f db/schema/003_roles.sql
ANALYST_DB_URL=postgresql+psycopg://analyst_ro:<password>@localhost:5432/analyst-agent

# SEC EDGAR requires a descriptive User-Agent with contact details,
# or it returns 403. Format: "app-name your@email.com"
SEC_USER_AGENT=analyst-agent your@email.com

# AWS Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

MCP_HOST=127.0.0.1
MCP_PORT=8765
